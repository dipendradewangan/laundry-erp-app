# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# Application environment
# Possible values: development, staging, production
NODE_ENV=development

# Backend API port
PORT=5000


# ==========================================
# CORE DATABASE - MYSQL
# ==========================================

# Main business database
# Replace the placeholders with your local/server MySQL credentials.
DATABASE_URL="mysql://MYSQL_USER:MYSQL_PASSWORD@localhost:3306/laundry_core"


# ==========================================
# AUDIT DATABASE - MYSQL
# ==========================================

# Separate database for Audit Trail, Security Logs,
# Login Logs and other historical system activities.
AUDIT_DATABASE_URL="mysql://MYSQL_USER:MYSQL_PASSWORD@localhost:3306/laundry_audit"


# ==========================================
# REDIS
# ==========================================

# Redis connection URL
# Used for caching, sessions, rate limiting,
# temporary data and future background processing.
REDIS_URL="redis://localhost:6379"


# ==========================================
# JWT AUTHENTICATION
# ==========================================

# Secret used to sign access tokens.
# IMPORTANT: Use a long random secret in real environments.
JWT_ACCESS_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_ACCESS_SECRET"

# Secret used to sign refresh tokens.
# Keep this different from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_REFRESH_SECRET"

# Access token lifetime
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN="7d"


# ==========================================
# CORS
# ==========================================

# Frontend URL allowed to access the backend.
# Development example:
FRONTEND_URL="http://localhost:5173"


# ==========================================
# LOGGING
# ==========================================

# Application log level
# Possible values: error, warn, info, debug
LOG_LEVEL="debug"