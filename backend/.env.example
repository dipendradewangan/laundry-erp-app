# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
PORT=5000



# ==========================================
# MYSQL SERVER CONNECTION
# ==========================================

# Used only during application bootstrap
# to create required databases if they do not exist.
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="YOUR_MYSQL_PASSWORD"



# ==========================================
# CORE DATABASE
# ==========================================

DATABASE_URL="mysql://MYSQL_USER:MYSQL_PASSWORD@localhost:3306/laundry_core"


# ==========================================
# AUDIT DATABASE
# ==========================================

AUDIT_DATABASE_URL="mysql://MYSQL_USER:MYSQL_PASSWORD@localhost:3306/laundry_audit"


# ==========================================
# REDIS
# ==========================================

REDIS_URL="redis://localhost:6379"


# ==========================================
# JWT
# ==========================================

JWT_ACCESS_SECRET="CHANGE_ME_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_SECRET"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"


# ==========================================
# FRONTEND
# ==========================================

FRONTEND_URL="http://localhost:5173"


# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL="debug"


# ============================================================
# GOOGLE AUTHENTICATION
# ============================================================

GOOGLE_CLIENT_ID=your-google-client-id
