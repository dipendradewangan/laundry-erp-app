# =========================================================
# NODE.JS / JAVASCRIPT
# =========================================================

# Dependencies
node_modules/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Optional npm cache
.npm/


# =========================================================
# ENVIRONMENT VARIABLES / SECRETS
# =========================================================

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow example environment files
!.env.example


# =========================================================
# LOG FILES
# =========================================================

*.log
logs/
log/


# =========================================================
# BUILD / DISTRIBUTION
# =========================================================

# Generic build directories
dist/
build/
out/

# Frontend build/cache
.next/
.nuxt/
.cache/
.vite/


# =========================================================
# TEST / COVERAGE
# =========================================================

coverage/
.nyc_output/


# =========================================================
# PRISMA
# =========================================================

# Prisma generated local database files
*.db
*.db-journal

# Prisma generated artifacts
# NOTE:
# Do NOT ignore prisma migrations.
# Migration files must be committed to Git.


# =========================================================
# TYPESCRIPT / JAVASCRIPT CACHE
# =========================================================

*.tsbuildinfo


# =========================================================
# IDE / EDITOR
# =========================================================

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# IntelliJ / WebStorm
.idea/

# Sublime Text
*.sublime-workspace
*.sublime-project


# =========================================================
# OPERATING SYSTEM FILES
# =========================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

# Linux
*~


# =========================================================
# TEMPORARY FILES
# =========================================================

*.tmp
*.temp
*.swp
*.swo

# Temporary folders
tmp/
temp/


# =========================================================
# UPLOADS / GENERATED FILES
# =========================================================

# Local uploaded/generated files
uploads/*
!uploads/.gitkeep

storage/*
!storage/.gitkeep

generated/*
!generated/.gitkeep


# =========================================================
# REPORTS / EXPORTS
# =========================================================

*.csv
*.xlsx
*.xls
*.pdf


# =========================================================
# LOCAL DEVELOPMENT DATA
# =========================================================

# Local dumps / backups
*.sql
*.sql.gz
*.dump
*.bak

# NOTE:
# Do NOT keep production database backups inside Git.


# =========================================================
# SECURITY / CERTIFICATES
# =========================================================

*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Local certificates
certs/*
!certs/.gitkeep


# =========================================================
# DOCKER LOCAL OVERRIDES
# =========================================================

docker-compose.override.yml


# =========================================================
# OS / TOOL GENERATED FILES
# =========================================================

.npm/
.yarn/
.pnpm-store/